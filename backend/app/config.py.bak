"""
Application configuration — single source of truth for all settings.
Loaded from environment variables / .env file via Pydantic Settings.
"""
from functools import lru_cache
from typing import Literal

from pydantic import Field, computed_field
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=False,
        extra="ignore",
    )

    # ── App ──────────────────────────────────────────────────────────────────
    env: Literal["development", "staging", "production"] = "development"
    app_name: str = "axis-ai"
    app_version: str = "0.1.0"
    debug: bool = False
    secret_key: str = Field(default="change-me-in-production", min_length=32)
    master_api_key: str = "dev-master-key-change-in-production"

    # ── Database ──────────────────────────────────────────────────────────────
    database_url: str = "postgresql+asyncpg://axis:axisdev@localhost:5432/axis_ai"
    db_pool_size: int = 10
    db_max_overflow: int = 20
    db_pool_timeout: int = 30
    db_echo: bool = False  # Set True to log all SQL (very verbose)

    # ── Redis ─────────────────────────────────────────────────────────────────
    redis_url: str = "redis://:redisdev@localhost:6379/0"

    # ── Qdrant ────────────────────────────────────────────────────────────────
    qdrant_host: str = "localhost"
    qdrant_port: int = 6333
    qdrant_api_key: str = "qdrantdev"
    qdrant_grpc_port: int = 6334
    qdrant_use_grpc: bool = False
    qdrant_https: bool = False  # Set True in production (Qdrant Cloud / TLS)

    qdrant_collection_content_chunks: str = "axis_content_chunks"
    qdrant_collection_kb_chunks: str = "axis_kb_chunks"
    qdrant_collection_content_intelligence: str = "axis_content_intelligence"
    qdrant_collection_question_intelligence: str = "axis_question_intelligence"
    qdrant_vector_size: int = 1536

    # ── AI Providers ──────────────────────────────────────────────────────────
    openai_api_key: str = ""
    anthropic_api_key: str = ""
    mistral_api_key: str = ""

    default_ai_provider: str = "openai"
    default_embedding_model: str = "text-embedding-3-small"
    default_chat_model: str = "gpt-4o-mini"

    # Task-specific model overrides
    model_summary: str = "gpt-4o-mini"
    model_quiz: str = "gpt-4o"
    model_flashcards: str = "gpt-4o-mini"
    model_glossary: str = "gpt-4o-mini"
    model_mindmap: str = "gpt-4o-mini"
    model_objectives: str = "gpt-4o-mini"
    model_blooms: str = "gpt-4o-mini"
    model_translation: str = "gpt-4o-mini"

    # Chat-specific model config
    model_chat: str = "gpt-4o-mini"            # Default answer model
    model_chat_intent: str = "gpt-4o-mini"     # Intent classifier (fast + cheap)
    model_chat_advanced: str = "gpt-4o"        # Used for QUIZ_ME, COMPARE intents
    chat_rag_min_score: float = 0.35            # Minimum Qdrant similarity score
    chat_history_window: int = 10              # Messages included in prompt
    chat_summary_threshold: int = 15          # Trigger rolling summary after N messages

    # Chat rate limits
    chat_cooldown_seconds: int = 2             # Min seconds between messages per user
    chat_max_session_messages: int = 100       # Max messages per session (user+assistant combined)
    chat_max_user_messages_day: int = 200      # Max messages a single user can send per day
    chat_max_user_tokens_day: int = 50_000     # Soft token budget per user per day
    chat_max_tenant_tokens_month: int = 10_000_000  # Hard token cap per tenant per month
    chat_session_ttl_hours: int = 4            # Mark session inactive after N hours of silence

    # ── Celery ────────────────────────────────────────────────────────────────
    celery_broker_url: str = "redis://:redisdev@localhost:6379/1"
    celery_result_backend: str = "redis://:redisdev@localhost:6379/2"

    # ── Chunking ──────────────────────────────────────────────────────────────
    default_chunk_size: int = 1000
    default_chunk_overlap: int = 200
    default_chunking_strategy: Literal["recursive", "semantic", "token"] = "recursive"

    # ── Rate Limits ───────────────────────────────────────────────────────────
    rate_limit_global_tokens_hour: int = 500_000
    rate_limit_global_tokens_day: int = 5_000_000
    rate_limit_global_tokens_month: int = 50_000_000
    rate_limit_per_course_tokens_day: int = 50_000
    rate_limit_per_user_tokens_day: int = 10_000

    # ── Video processing ──────────────────────────────────────────────────────
    # Vimeo personal access token — used when not passed per-request in metadata.
    # Per-request token (from ingest metadata.vimeo_token) always takes priority.
    vimeo_access_token: str = ""

    # YouTube Data API v3 key — optional; youtube-transcript-api is used first (no key needed).
    # Only needed if you want to fall back to the official API for quota-heavy workloads.
    youtube_api_key: str = ""

    # PeerTube — no API key required for public instances.
    # The instance URL is always extracted from the video URL itself (federated platform).
    # Set PEERTUBE_DEFAULT_INSTANCE to restrict ingest to a single trusted instance
    # (leave blank to allow any PeerTube instance URL).
    peertube_default_instance: str = ""

    # Whisper model size: tiny | base | small | medium | large
    # Larger = more accurate but slower and more memory.
    # "base" is a good default (74M params, ~1GB RAM, ~10x realtime on CPU).
    whisper_model: str = "base"

    # Whether to attempt Whisper transcription when no captions are available.
    # Set to False to fail fast instead of downloading audio for every uncaptioned video.
    whisper_fallback_enabled: bool = True

    # ── File handling ─────────────────────────────────────────────────────────
    upload_dir: str = "/tmp/axis_uploads"
    max_file_size_mb: int = 100

    # ── Observability ─────────────────────────────────────────────────────────
    log_level: Literal["DEBUG", "INFO", "WARNING", "ERROR"] = "INFO"
    log_format: Literal["json", "console"] = "json"
    prometheus_enabled: bool = True

    # ── CORS ──────────────────────────────────────────────────────────────────
    cors_origins: str = "http://localhost,http://localhost:8080"


    # ── SMTP / Email ──────────────────────────────────────────────────────────
    smtp_host: str = ""
    smtp_port: int = 587
    smtp_user: str = ""
    smtp_password: str = ""
    smtp_from: str = ""
    smtp_from_name: str = "Axis AI"
    smtp_use_tls: bool = True          # STARTTLS (port 587). Set False for SSL (port 465).
    smtp_use_ssl: bool = False          # Direct SSL (port 465). Takes priority over smtp_use_tls.

    # ── Google OAuth ──────────────────────────────────────────────────────────
    google_client_id: str = ""
    google_client_secret: str = ""
    # Redirect URI must match exactly what's registered in Google Cloud Console.
    # Example: https://axis.edzlms.com/api/auth/google/callback
    google_redirect_uri: str = ""

    # ── LTI 1.3 ───────────────────────────────────────────────────────────────
    # Generate key pair via POST /api/v1/admin/lti/generate-keypair
    lti_private_key_pem: str = ""
    lti_key_id: str = "axis-ai-key-1"
    frontend_url: str = "https://axis.edzlms.com"
    backend_url: str = "https://axisai.edzlms.com"

    # ── Video Creation (local_edzaxisvideo) ───────────────────────────────────
    video_enabled: bool = True

    # Storage backend for finished MP4s and thumbnails
    video_storage: Literal["local", "s3"] = "local"
    video_output_dir: str = "/data/video_outputs"
    # Public URL prefix — nginx must serve video_output_dir at this path
    video_output_base_url: str = ""

    # S3 (only when video_storage = "s3")
    video_s3_bucket: str = ""
    video_s3_region: str = "ap-south-1"
    video_s3_cdn_url: str = ""          # CDN URL if CloudFront/R2 is in front
    video_s3_access_key_id: str = ""
    video_s3_secret_access_key: str = ""

    # TTS provider (Tier 0 default — edge_tts requires no API key)
    video_tts_provider: Literal["edge_tts", "openai", "elevenlabs", "gtts"] = "edge_tts"
    video_openai_tts_key: str = ""
    video_elevenlabs_key: str = ""

    # Image generation (Tier 0 = none; higher tiers set per-tenant in config JSONB)
    video_image_gen: Literal["none", "dalle3", "sdxl_local"] = "none"
    video_sdxl_local_url: str = "http://localhost:7860"  # Automatic1111 API

    # Stock footage
    video_pexels_api_key: str = ""

    # HeyGen (avatar type — global fallback; per-tenant keys in tenants.config JSONB)
    video_heygen_key: str = ""
    video_d_id_key: str = ""
    video_pictory_key: str = ""

    # FFmpeg quality gate
    skip_ffmpeg_gate: bool = False           # Set true in .env for local dev (skips re-encode)
    video_export_codec: str = "libx264"     # libx264 (safe default) or libx265
    video_export_crf: int = 22
    video_export_bitrate: str = "8000k"
    video_export_audio_bitrate: str = "192k"

    # Rendering limits
    video_max_duration_seconds: int = 600   # 10-minute hard cap
    video_temp_dir: str = "/tmp/axis_video"
    video_celery_concurrency: int = 2

    # LLM model for scene planning (use cheapest capable model)
    video_llm_planner_model: str = "gpt-4o-mini"

    # AES-256 encryption key for per-tenant API keys in tenants.config JSONB
    # Generate: openssl rand -hex 32
    video_encryption_key: str = ""

    # ── Computed ──────────────────────────────────────────────────────────────
    @computed_field  # type: ignore[misc]
    @property
    def cors_origins_list(self) -> list[str]:
        return [o.strip() for o in self.cors_origins.split(",") if o.strip()]

    @computed_field  # type: ignore[misc]
    @property
    def is_production(self) -> bool:
        return self.env == "production"

    @computed_field  # type: ignore[misc]
    @property
    def max_file_size_bytes(self) -> int:
        return self.max_file_size_mb * 1024 * 1024

    def model_for_task(self, task_type: str) -> str:
        """Return the configured model for a given task type."""
        mapping = {
            "summary": self.model_summary,
            "quiz": self.model_quiz,
            "flashcards": self.model_flashcards,
            "glossary": self.model_glossary,
            "mindmap": self.model_mindmap,
            "objectives": self.model_objectives,
            "blooms": self.model_blooms,
            "translation": self.model_translation,
            # Chat
            "chat": self.model_chat,
            "chat_intent": self.model_chat_intent,
            "chat_embed": self.default_embedding_model,
            "chat_advanced": self.model_chat_advanced,
        }
        return mapping.get(task_type, self.default_chat_model)


@lru_cache
def get_settings() -> Settings:
    """Cached settings instance — call this everywhere."""
    return Settings()


# Convenience alias
settings = get_settings()
